{"id":"surface-fix-gaps/original/surface/ddl/create-external-table-transact-sql/example-008","source":"CREATE EXTERNAL DATA SOURCE SQLServerInstance\nWITH (\nLOCATION = 'sqlserver://SqlServer',\n    CREDENTIAL = SQLServerCredentials\n);\nGO\nCREATE SCHEMA sqlserver;\nCREATE EXTERNAL TABLE sqlserver.customer (\n    C_CUSTKEY INT NOT NULL,\n    C_NAME VARCHAR(25) NOT NULL,\n    C_ADDRESS VARCHAR(40) NOT NULL,\n    C_NATIONKEY INT NOT NULL,\n    C_PHONE CHAR(15) NOT NULL,\n    C_ACCTBAL DECIMAL(15,2) NOT NULL,\n    C_MKTSEGMENT CHAR(10) NOT NULL,\n    C_COMMENT VARCHAR(117) NOT NULL\n)\nWITH (\n    LOCATION='tpch_10.dbo.customer',\n    DATA_SOURCE=SqlServerInstance\n);\n","sha256":"8584625e98bc754dddd1a22d55ce678bac8b6d3dedde2db09226a5deacd3401d"}
{"id":"surface-fix-gaps/original/surface/ddl/create-external-table-transact-sql/example-012","source":"CREATE EXTERNAL DATA SOURCE s3_ds\nWITH\n(   LOCATION = 's3://<ip_address>:<port>/',\n    CREDENTIAL = s3_dc\n);\nGO\nCREATE EXTERNAL FILE FORMAT ParquetFileFormat\nWITH(\n    FORMAT_TYPE = PARQUET\n);\nGO\nCREATE EXTERNAL TABLE Region (\n    r_regionkey BIGINT,\n    r_name CHAR(25),\n    r_comment VARCHAR(152)\n)\nWITH (\n    LOCATION = '/region/',\n    DATA_SOURCE = 's3_ds',\n    FILE_FORMAT = ParquetFileFormat\n);\n","sha256":"551a0dcbe583c1de42506803f477f426a4f58ad5cb75a208d4014708a81b03d9"}
