<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Dependencies are pinned by packages.lock.json; CI restores with locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runner records the hash of its own source in every verdict file. -->
    <EmbeddedResource Include="Program.cs" LogicalName="runner-source/Program.cs" />
    <EmbeddedResource Include="ParseOnly.csproj" LogicalName="runner-source/ParseOnly.csproj" />
  </ItemGroup>

</Project>
